{
  "model_name": "tfidf_lr_v1",
  "vectorizer_type": "TfidfVectorizer",
  "classifier_type": "LinearSVC",
  "input_text": "model_text + review_text + decision_text",
  "train_rows": 16308,
  "val_rows": 3495,
