# ML model outputs
# ----------------------------
ml_pipeline/outputs/models/
ml_pipeline/outputs/model_artifacts/

# ----------------------------
# Backend exported model artifacts
# ----------------------------
backend/ml_assets/models/

# Keep backend registry if needed
!backend/ml_assets/registry.json

