# ----------------------------
# ML processed files
# Ignore all by default, then re-include the 4 LFS-tracked CSVs
# ----------------------------
ml_pipeline/data/processed/*.jsonl
ml_pipeline/data/processed/*.csv

!ml_pipeline/data/processed/labeled_dataset.csv
!ml_pipeline/data/processed/train.csv
!ml_pipeline/data/processed/val.csv
!ml_pipeline/data/processed/test.csv

# Old backups
ml_pipeline/data/processed/*old_imbalanced*.csv

