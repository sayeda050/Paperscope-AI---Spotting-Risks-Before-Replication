    "token_pattern": "(?u)\\b\\w\\w+\\b",
    "tokenizer": null,
    "use_idf": true,
    "vocabulary": null
  },
  "classifier_params": {
    "C": 1.0,
    "class_weight": "balanced",
    "dual": "auto",
    "fit_intercept": true,
    "intercept_scaling": 1,
    "loss": "squared_hinge",
    "max_iter": 1000,
    "multi_class": "ovr",
